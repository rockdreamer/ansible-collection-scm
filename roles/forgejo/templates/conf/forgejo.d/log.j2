;; git id 12.0.0-dev-323-8b93f41aaa by update_from_default_ini.py

{% if forgejo_log is defined and
    forgejo_log | count > 0 %}

[log]


{% if forgejo_log.root_path | default('') | string | length > 0 %}
ROOT_PATH = {{ forgejo_log.root_path }}
{% endif %}

{% if forgejo_log.mode is defined and
forgejo_log.mode | count > 0 %}
MODE = {{ forgejo_log.mode | join(', ') }}
{% endif %}

{% if forgejo_log.level | default('') | string | length > 0 %}
LEVEL = {{ forgejo_log.level }}
{% endif %}

{% if forgejo_log.stacktrace_level | default('') | string | length > 0 %}
STACKTRACE_LEVEL = {{ forgejo_log.stacktrace_level }}
{% endif %}

{% if forgejo_log.buffer_len | default('') | string | length > 0 %}
BUFFER_LEN = {{ forgejo_log.buffer_len }}
{% endif %}

{% if forgejo_log.logger.access.mode | default('') | string | length > 0 %}
logger.access.MODE = {{ forgejo_log.logger.access.mode }}
{% endif %}

{% if forgejo_log.logger.router.mode is defined and
forgejo_log.logger.router.mode | count > 0 %}
logger.router.MODE = {{ forgejo_log.logger.router.mode | join(', ') }}
{% endif %}

{% if forgejo_log.logger.xorm.mode is defined and
forgejo_log.logger.xorm.mode | count > 0 %}
logger.xorm.MODE = {{ forgejo_log.logger.xorm.mode | join(', ') }}
{% endif %}

{% if forgejo_log.enable_ssh_log | default('') | string | length > 0 %}
ENABLE_SSH_LOG = {{ forgejo_log.enable_ssh_log | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}

{% if forgejo_log.request_id_headers | default('') | string | length > 0 %}
REQUEST_ID_HEADERS = {{ forgejo_log.request_id_headers }}
{% endif %}

{% if forgejo_log.access_log_template | default('') | string | length > 0 %}
ACCESS_LOG_TEMPLATE = {{ forgejo_log.access_log_template }}
{% endif %}

;; DISABLE_ROUTER_LOG is deprecated: Use 'forgejo_log.logger.router.mode = none' instead

{% if forgejo_log.disable_router_log | default('') | string | length > 0 %}
DISABLE_ROUTER_LOG = {{ forgejo_log.disable_router_log | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}

;; ROUTER is deprecated: Use 'forgejo_log.logger.router.mode = none' instead

{% if forgejo_log.router | default('') | string | length > 0 %}
ROUTER = {{ forgejo_log.router | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}

;; ENABLE_ACCESS_LOG is deprecated: Use 'logger.access.MODE=,' instead

{% if forgejo_log.enable_access_log | default('') | string | length > 0 %}
ENABLE_ACCESS_LOG = {{ forgejo_log.enable_access_log | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}

;; ACCESS is deprecated: Use 'logger.access.MODE' instead

{% if forgejo_log.access | default('') | string | length > 0 %}
ACCESS = {{ forgejo_log.access | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}
{% endif %}

{# Section log.%(WriterMode) is custom-handled in forgejo.custom.d/log_writermode.j2 #}


