;; Ansible jinja template metrics.j2 generated from /custom/conf/app.default.ini
;; git id 12.0.0-dev-323-8b93f41aaa by update_from_default_ini.py

{% if forgejo_metrics is defined and forgejo_metrics | count > 0 and
    forgejo_metrics.enabled | default('false') | bool %}

[metrics]


{% if forgejo_metrics.enabled | default('') | string | length > 0 %}
ENABLED = {{ forgejo_metrics.enabled | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}

{% if forgejo_metrics.token | default('') | string | length > 0 %}
TOKEN = {{ forgejo_metrics.token }}
{% endif %}

{% if forgejo_metrics.enabled_issue_by_label | default('') | string | length > 0 %}
ENABLED_ISSUE_BY_LABEL = {{ forgejo_metrics.enabled_issue_by_label | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}

{% if forgejo_metrics.enabled_issue_by_repository | default('') | string | length > 0 %}
ENABLED_ISSUE_BY_REPOSITORY = {{ forgejo_metrics.enabled_issue_by_repository | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}
{% endif %}