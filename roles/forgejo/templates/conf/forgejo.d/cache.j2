{% if forgejo_cache is defined and
    forgejo_cache | count > 0 %}

[cache]


{% if forgejo_cache.adapter | default('') | string | length > 0 %}
ADAPTER = {{ forgejo_cache.adapter }}
{% endif %}

{% if forgejo_cache.interval | default('') | string | length > 0 %}
INTERVAL = {{ forgejo_cache.interval }}
{% endif %}

{% if forgejo_cache.host | default('') | string | length > 0 %}
HOST = {{ forgejo_cache.host }}
{% endif %}

{% if forgejo_cache.item_ttl | default('') | string | length > 0 %}
ITEM_TTL = {{ forgejo_cache.item_ttl }}
{% endif %}
{% endif %}
{% if forgejo_cache.last_commit is defined and
    forgejo_cache.last_commit | count > 0 %}

[cache.last_commit]


{% if forgejo_cache.last_commit.item_ttl | default('') | string | length > 0 %}
ITEM_TTL = {{ forgejo_cache.last_commit.item_ttl }}
{% endif %}

{% if forgejo_cache.last_commit.commits_count | default('') | string | length > 0 %}
COMMITS_COUNT = {{ forgejo_cache.last_commit.commits_count }}
{% endif %}
{% endif %}