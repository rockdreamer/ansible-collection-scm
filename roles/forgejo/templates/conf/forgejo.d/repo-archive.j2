{% if forgejo_repo_archive is defined and
    forgejo_repo_archive | count > 0 %}

[repo-archive]


{% if forgejo_repo_archive.storage_type | default('') | string | length > 0 %}
STORAGE_TYPE = {{ forgejo_repo_archive.storage_type }}
{% endif %}

{% if forgejo_repo_archive.path | default('') | string | length > 0 %}
PATH = {{ forgejo_repo_archive.path }}
{% endif %}

{% if forgejo_repo_archive.minio_base_path | default('') | string | length > 0 %}
MINIO_BASE_PATH = {{ forgejo_repo_archive.minio_base_path }}
{% endif %}
{% endif %}