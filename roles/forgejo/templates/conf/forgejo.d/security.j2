{% endif %}

{% if forgejo_security.reverse_proxy_trusted_proxies is defined and
forgejo_security.reverse_proxy_trusted_proxies | count > 0 %}
REVERSE_PROXY_TRUSTED_PROXIES = {{ forgejo_security.reverse_proxy_trusted_proxies | join(', ') }}
{% endif %}

{% if forgejo_security.min_password_length | default('') | string | length > 0 %}
