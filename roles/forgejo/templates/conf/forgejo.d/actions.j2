;; Ansible jinja template actions.j2 generated from /custom/conf/app.default.ini
;; git id 12.0.0-dev-323-8b93f41aaa by update_from_default_ini.py

{% if forgejo_actions is defined and
    forgejo_actions | count > 0 %}

[actions]


{% if forgejo_actions.enabled | default('') | string | length > 0 %}
ENABLED = {{ forgejo_actions.enabled | bodsch.core.config_bool(true_as='true', false_as='false') }}
{% endif %}

{% if forgejo_actions.default_actions_url | default('') | string | length > 0 %}
DEFAULT_ACTIONS_URL = {{ forgejo_actions.default_actions_url }}
{% endif %}

{% if forgejo_actions.log_retention_days | default('') | string | length > 0 %}
LOG_RETENTION_DAYS = {{ forgejo_actions.log_retention_days }}
{% endif %}

{% if forgejo_actions.log_compression | default('') | string | length > 0 %}
LOG_COMPRESSION = {{ forgejo_actions.log_compression }}
{% endif %}

{% if forgejo_actions.artifact_retention_days | default('') | string | length > 0 %}
ARTIFACT_RETENTION_DAYS = {{ forgejo_actions.artifact_retention_days }}
{% endif %}

{% if forgejo_actions.zombie_task_timeout | default('') | string | length > 0 %}
ZOMBIE_TASK_TIMEOUT = {{ forgejo_actions.zombie_task_timeout }}
{% endif %}

{% if forgejo_actions.endless_task_timeout | default('') | string | length > 0 %}
ENDLESS_TASK_TIMEOUT = {{ forgejo_actions.endless_task_timeout }}
{% endif %}

{% if forgejo_actions.abandoned_job_timeout | default('') | string | length > 0 %}
ABANDONED_JOB_TIMEOUT = {{ forgejo_actions.abandoned_job_timeout }}
{% endif %}

{% if forgejo_actions.skip_workflow_strings is defined and
forgejo_actions.skip_workflow_strings | count > 0 %}
SKIP_WORKFLOW_STRINGS = {{ forgejo_actions.skip_workflow_strings | join(', ') }}
{% endif %}

{% if forgejo_actions.limit_dispatch_inputs | default('') | string | length > 0 %}
LIMIT_DISPATCH_INPUTS = {{ forgejo_actions.limit_dispatch_inputs }}
{% endif %}
{% endif %}